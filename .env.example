DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studio_slots"
# Base URL used in password reset emails
APP_URL="http://localhost:3000"
# Optional: without it, reset links are printed to the server console
RESEND_API_KEY=""
MAIL_FROM="StudioSlots <no-reply@studioslots.app>"
# Staff password for the seed script (required, 12+ characters)
SEED_OWNER_PASSWORD=""
# Set to 1 only behind a proxy that sets x-real-ip / X-Forwarded-For (Vercel, nginx)
TRUST_PROXY=""
